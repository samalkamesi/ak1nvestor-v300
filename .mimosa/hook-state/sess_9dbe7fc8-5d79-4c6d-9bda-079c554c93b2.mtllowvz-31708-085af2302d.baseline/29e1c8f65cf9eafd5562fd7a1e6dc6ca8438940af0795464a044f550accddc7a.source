// Sprakexpert A: scan4 — grammatiksignaturer + engelskalackor
const fs = require('fs');
const DB = 'C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/public/deep-courses.json';
const d = JSON.parse(fs.readFileSync(DB, 'utf8'));
const slugs = Object.keys(d).sort().slice(0, 84);
const SWE = s => /^(km-|bf-|ak1ts|akm1|foretags)/.test(s);

function walk(obj, path, out) {
  if (typeof obj === 'string') out.push([path, obj]);
  else if (Array.isArray(obj)) obj.forEach((v, i) => walk(v, path + '[' + i + ']', out));
  else if (obj && typeof obj === 'object') for (const k of Object.keys(obj)) walk(obj[k], path + '.' + k, out);
}

const checks = [
  [/\bvilken (två|tre|fyra|fem|sex|sju|åtta|nio|tio|flera|båda)\b/gi, 'vilken+plural'],
  [/\bvilket (bolag|aktie|modell|person|fråga|regel|strategi|metod|position|berättelse|analys|bok|kurs|kvartal|gång|andel|vinst|förlust|del|gång)\b/gi, 'vilket+en-ord'],
  [/\bmin (bolag|aktie|analys|strategi|fråga|modell|regel|bok|kurs|position|berättelse|vinst|förlust|andel|intäk|utgif|idé|tes|uppgift|portfölj)\b/gi, 'min+en-ord'],
  [/\bdin (bolag|aktie|analys|strategi|fråga|modell|regel|bok|kurs|position|berättelse|vinst|förlust|andel|intäk|utgif|idé|tes|uppgift|portfölj)\b/gi, 'din+en-ord'],
  [/\bsin (bolag|aktie|analys|strategi|fråga|modell|regel|bok|kurs|position|berättelse|vinst|förlust|andel|intäk|utgif|idé|tes|uppgift|portfölj)\b/gi, 'sin+en-ord'],
  [/\ben (sätt|pris|värde|mål|test|exempel|scenario|kapitel|konto|program|belopp|tal|ämne|beslut|steg|verktyg|krav|ställe|råd|argument|medel|system|mönster|tålamod|tvivel|val|vapen|brev|bud|slag|lag|spår|svar|stick|tröskel|parti|lyckotal|benchmark-mått|normalvärde|genomsnitt|uppslag|stöd|stop|kriterium)\b/gi, 'en+ett-ord'],
  [/\bett (bolag|aktie|strategi|modell|metod|fråga|regel|position|analys|berättelse|bok|kurs|kvartal|räkning|lista|tabell|källa|vinst|förlust|multippel|nyckeltal|fall|tes|uppgift|princip|kod|beräkning|jämförelse|bedömning|utmaning|fördel|risk|nivå|struktur|kultur|generation|indikator|tumregel|checklista|portfölj|aktie|kassaflöde|värdering|sektor|bransch|konsument|kund|marknad|sekvens|dimension|horisont|kvantil|decil|faktor|signal|varning|flagga|fälla|bias|regel|referens|motpart|kundfordran|intäktsström|tillgångsklass|premie|spread)\b/gi, 'ett+en-ord'],
  [/\b(störst|mest|bäst|värst|största|mesta|bästa|värsta) av all\b/gi, 'av all'],
  [/\bmotsatsen är (sin|hans|hennes)\b/gi, 'skip'],
  [/\bju (högre|lägre|mer|mindre|större|snabbare|längre|bättre|sämre|dyrare|billigare) .{0,40} desto \w+/gi, 'ju-desto OK skip'],
];

const out = fs.createWriteStream('C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/tmp_parts/sprak-A/hits4.txt');
const engOut = fs.createWriteStream('C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/tmp_parts/sprak-A/hits4-eng.txt');

for (const s of slugs) {
  const strs = []; walk(d[s], s, strs);
  for (const [path, text] of strs) {
    for (const [re, label] of checks) {
      if (label.includes('skip')) continue;
      const m = text.match(new RegExp(re.source, 'gi'));
      if (m) for (const hit of m) {
        const idx = text.toLowerCase().indexOf(hit.toLowerCase());
        out.write('[' + label + '] ' + s + ' ' + path + ' :: …' + text.slice(Math.max(0, idx - 55), idx + hit.length + 55).replace(/\n/g, ' | ') + '…\n');
      }
    }
    if (SWE(s)) {
      // engelska fteord i svensk text (kurser med svensk originaltext)
      const re = /\b(the|and|with|of|that|this|from|they|their|because|which|should|would|than|then|when|where|while|also|only|very|some|any|not|is|are|was|were|has|have|will|can|about|into|over|under|more|most|make|made|take|taken|used|using|based|instead|between|through|during|after|before|both|each|other|same|such|just|even|still|there|here|what|who|how|why)\b/gi;
      let m;
      while ((m = re.exec(text))) {
        // hoppa over kanda latinska/engelska termer som ar citerade eller vedertagna
        const w = m[1].toLowerCase();
        const around = text.slice(Math.max(0, m.index - 25), m.index + 30);
        if (/[»«'"“”(]/.test(around) && /['"»«]/.test(around)) { /* citrisken - skriv andvays */ }
        engOut.write('[' + w + '] ' + s + ' ' + path + ' :: …' + text.slice(Math.max(0, m.index - 45), m.index + 45).replace(/\n/g, ' | ') + '…\n');
      }
    }
  }
}
out.end(); engOut.end();
console.log('klart');
