const log = [];
let total = 0, miss = 0, overmax = 0;
for (const [slug, o, n, mx] of FIX) {
  const targets = slug === '*A*' ? ALL : [slug];
  if (slug !== '*A*' && !inA.has(slug)) { log.push('OGILTIG SLUG: ' + slug); miss++; continue; }
  const c = { n: 0 };
  for (const t of targets) d[t] = walkReplace(d[t], o, n, c);
  if (c.n === 0) { log.push('MISS [' + slug + '] ' + o.slice(0, 55)); miss++; }
  else if (c.n > mx) { log.push('FÖRMÅNGA (' + c.n + '>' + mx + ') [' + slug + '] ' + o.slice(0, 55)); overmax++; }
  else { total += c.n; log.push('OK ' + c.n + ' [' + slug + '] ' + o.slice(0, 45) + ' → ' + n.slice(0, 45)); }
}

fs.writeFileSync(DB, JSON.stringify(d, null, 2) + '\n');
fs.writeFileSync('C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/tmp_parts/sprak-A/fixlog2.txt', log.join('\n'));
console.log('Ersatta förekomster:', total, '| MISS:', miss, '| FÖRMÅNGA:', overmax);
