const fs = require('fs');
const DB = 'C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/public/deep-courses.json';
const raw0 = fs.readFileSync(DB, 'utf8');
const d = JSON.parse(raw0);
const ALL = Object.keys(d).sort().slice(0, 84);
const inA = new Set(ALL);

function walkReplace(obj, oldS, newS, counter) {
  if (typeof obj === 'string') { if (obj.includes(oldS)) { counter.n += oldS === newS ? 0 : obj.split(oldS).length - 1; return obj.split(oldS).join(newS); } return obj; }
  if (Array.isArray(obj)) return obj.map(v => walkReplace(v, oldS, newS, counter));
  if (obj && typeof obj === 'object') { for (const k of Object.keys(obj)) obj[k] = walkReplace(obj[k], oldS, newS, counter); return obj; }
  return obj;
}

