// dump for lasning: grupp + index
const fs = require('fs');
const DB = 'C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/public/deep-courses.json';
const d = JSON.parse(fs.readFileSync(DB, 'utf8'));
const slugs = Object.keys(d).sort().slice(0, 84);
const SWE = s => /^(km-|bf-|ak1ts|akm1|foretags)/.test(s);
const mode = process.argv[2]; // 'bok-meta' | 'swe-meta' | 'swe-ch'
const from = +process.argv[3], to = +process.argv[4];
const sel = mode === 'bok-meta' ? slugs.filter(s => !SWE(s)) : slugs.filter(SWE);

let out = '';
sel.slice(from, to).forEach((s, n) => {
  const c = d[s];
  out += '\n######## ' + s + ' ########\n';
  if (mode.endsWith('meta')) {
    out += 'TITLE: ' + (c.title || '') + '\n';
    out += 'SUMMARY: ' + (c.summary || '') + '\n';
    out += 'WHY: ' + (c.why || '') + '\n';
    out += 'LEARN: ' + (c.learn || '') + '\n';
    if (c.lynchSection) out += 'LYNCH: ' + c.lynchSection + '\n';
    if (c.grahamSection) out += 'GRAHAM: ' + c.grahamSection + '\n';
    if (c.ak1Section) out += 'AK1: ' + c.ak1Section + '\n';
    if (c.history) out += 'HISTORY: ' + JSON.stringify(c.history) + '\n';
  }
  if (mode === 'swe-ch') {
    const chs = c.chapters || [];
    const i = (from + n + chs.length) % chs.length; // roterande urval
    const k = chs[i];
    out += '>> KAPITEL ' + (i + 1) + '/' + chs.length + ': ' + (k.title || '') + '\n';
    out += 'INTRO: ' + (k.intro || '') + '\n';
    (k.blocks || []).forEach((b, bi) => {
      out += 'BLOCK ' + bi + ' (' + b.type + '): ' + (b.content || JSON.stringify(b)).slice(0, 1700) + '\n';
    });
    (k.quiz || []).forEach((q, qi) => {
      out += 'Q' + qi + ': ' + q.q + ' | ALT: ' + JSON.stringify(q.alternativ) + ' | RATT: ' + q.ratt + ' | TIPS: ' + (q.tips || '') + '\n';
    });
  }
});
fs.writeFileSync('C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/tmp_parts/sprak-A/dump.txt', out);
console.log('skrev', out.length, 'tecken for', mode, from, to);
