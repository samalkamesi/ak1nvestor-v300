  ['att sanna möjlister ofta doldes', 'att sanna möjligheter ofta doldes', 1],
  ['när investerars beslut drivs', 'när investerarnas beslut drivs', 1],
  ['där investerars köp- och säljbeslut', 'där investerarnas köp- och säljbeslut', 1],
  ['En psykologisk fenomen där', 'Ett psykologiskt fenomen där', 1],
  ['när panik säljer ut kvalitetsbolag', 'när paniken säljer ut kvalitetsbolag', 1],

  // === km-036 ===
  ['TITLE:PLACEHOLDER', 'x', 0], // se special nedan
];

// special: km-036 titel + km-001 AK1-bokföringsförståelse (två varianter)
const TITLE_FIX = [['Överconfidence', 'Overconfidence', 1]];
const KM001 = [['är bokförningsförståelse grunden', 'är bokföringsförståelse grunden', 0]];

let log = [];
let total = 0, miss = 0;
function apply(o, n, max, tag) {
  let c = 0, idx = -1;
  while ((idx = raw.indexOf(o, idx + 1)) !== -1) c++;
  if (c === 0) { log.push('MISS [' + tag + '] ' + o.slice(0, 60)); miss++; return; }
  if (c > max) { log.push('SKIP-FÖR MÅNGA (' + c + '>' + max + ') [' + tag + '] ' + o.slice(0, 60)); return; }
  raw = raw.split(o).join(n);
  total += c;
  log.push('OK (' + c + ') [' + tag + '] ' + o.slice(0, 50) + ' -> ' + n.slice(0, 50));
}

for (const [o, n, m] of FIX) { if (m === 0) continue; apply(o, n, m, 'A'); }
for (const [o, n, m] of KM001) { if (m === 0) continue; apply(o, n, m, 'km001'); }
// km-001: bokförningsförståelse -> bokföringsförståelse (ett forekomst, kursens AK1-text)
apply('I AKM1-metodiken är bokförningsförståelse grunden', 'I AKM1-metodiken är bokföringsförståelse grunden', 1, 'km001-bokf');

// titel: km-036 "Överconfidence" endast i title-faltet
{
  const t = '"title":"Överconfidence"';
  if (raw.includes(t)) { raw = raw.replace('"title":"Överconfidence"', '"title":"Overconfidence"'); total += 1; log.push('OK (1) [km036-title] Överconfidence'); }
  else log.push('MISS [km036-title]');
}

fs.writeFileSync(DB, raw);
fs.writeFileSync('C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/tmp_parts/sprak-A/fixlog.txt', log.join('\n'));
console.log('Totalt ersatta:', total, ' Missade:', miss);
