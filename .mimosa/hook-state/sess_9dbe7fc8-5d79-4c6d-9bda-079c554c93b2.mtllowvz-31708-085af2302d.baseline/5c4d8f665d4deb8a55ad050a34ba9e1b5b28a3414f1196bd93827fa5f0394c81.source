// Verifiering: alla avsedda rattningar sitter, strukturen oforandrad, inga gamla strangar kvar i batch A
const fs = require('fs');
const cur = JSON.parse(fs.readFileSync('C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/public/deep-courses.json', 'utf8'));
const base = JSON.parse(fs.readFileSync('C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/tmp_parts/sprak-A/baseline.json', 'utf8'));
const ALL = Object.keys(cur).sort().slice(0, 84);

// 1) struktur
let ok = true;
for (const s of ALL) {
  const c = cur[s];
  const b = base[s];
  const now = { ch: (c.chapters || []).length, q: (c.chapters || []).reduce((a, k) => a + (k.quiz ? k.quiz.length : 0), 0), bl: (c.chapters || []).reduce((a, k) => a + (k.blocks ? k.blocks.length : 0), 0) };
  if (now.ch !== b.ch || now.q !== b.q || now.bl !== b.b) { console.log('STRUKTURFEL', s, JSON.stringify(now), 'vs', JSON.stringify(b)); ok = false; }
}
console.log('Struktur (chapters/quiz/blocks) oförändrad för alla 84:', ok);

