  ['intermarket-analysis', /enligt läg\b(?!s)/g, 'enligt lag', 1],
  ['interpretation-of-financial-statements', /enligt läg\b(?!s)/g, 'enligt lag', 2],
  ['investment-valuation', /enligt läg\b(?!s)/g, 'enligt lag', 1],
  // övriga
  ['competition-demystified', 'den ramverk där konkurrensdiskussioner', 'det ramverk där konkurrensdiskussioner', 1],
  ['contrarian-investment-strategies', 'samtidigt en test av', 'samtidigt ett test av', 1],
  ['distress-investing', 'gjorde kategorien ökänd', 'gjorde kategorin ökänd', 1],
