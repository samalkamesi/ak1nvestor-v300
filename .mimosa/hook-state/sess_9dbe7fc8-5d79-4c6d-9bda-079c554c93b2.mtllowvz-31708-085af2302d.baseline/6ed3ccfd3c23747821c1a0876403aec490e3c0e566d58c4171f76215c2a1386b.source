// fix3: kompletterande rattningar + artefaktlagning
const fs = require('fs');
const DB = 'C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/public/deep-courses.json';
const d = JSON.parse(fs.readFileSync(DB, 'utf8'));
const ALL = Object.keys(d).sort().slice(0, 84);
const inA = new Set(ALL);

function rep(obj, re, newS, counter) {
  if (typeof obj === 'string') { const m = obj.match(re); if (m) { counter.n += m.length; return obj.replace(re, newS); } return obj; }
  if (Array.isArray(obj)) return obj.map(v => rep(v, re, newS, counter));
  if (obj && typeof obj === 'object') { for (const k of Object.keys(obj)) obj[k] = rep(obj[k], re, newS, counter); return obj; }
  return obj;
}
function repS(obj, o, n, counter) {
  if (typeof obj === 'string') { if (obj.includes(o)) { counter.n += obj.split(o).length - 1; return obj.split(o).join(n); } return obj; }
  if (Array.isArray(obj)) return obj.map(v => repS(v, o, n, counter));
  if (obj && typeof obj === 'object') { for (const k of Object.keys(obj)) obj[k] = repS(obj[k], o, n, counter); return obj; }
  return obj;
}

const FIX = [
  // artefakt
