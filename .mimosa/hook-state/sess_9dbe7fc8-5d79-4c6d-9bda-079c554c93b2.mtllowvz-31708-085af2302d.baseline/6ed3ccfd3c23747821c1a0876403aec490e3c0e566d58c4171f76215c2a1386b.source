  ['km-036-overconfidence', /\bSann(a)? mästerskap\b/g, 'Sant mästerskap', 1],
];

const log = []; let total = 0, miss = 0, over = 0;
for (const [slug, o, n, mx] of FIX) {
  if (!inA.has(slug)) { log.push('OGILTIG SLUG ' + slug); miss++; continue; }
  const c = { n: 0 };
  const res = (o instanceof RegExp) ? rep(d[slug], o, n, c) : repS(d[slug], o, n, c);
  if (c.n === 0) { log.push('MISS [' + slug + '] ' + String(o).slice(0, 50)); miss++; continue; }
  if (c.n > mx) { log.push('FÖRMÅNGA ' + c.n + '>' + mx + ' [' + slug + '] ' + String(o).slice(0, 40)); over++; continue; }
  d[slug] = res; total += c.n; log.push('OK ' + c.n + ' [' + slug + '] ' + String(o).slice(0, 40));
}
fs.writeFileSync(DB, JSON.stringify(d, null, 2) + '\n');
fs.writeFileSync('C:/Users/Workstation Z G4/.zcode/workspace/default/ak1/tmp_parts/sprak-A/fixlog3.txt', log.join('\n'));
console.log('Ersatta:', total, 'MISS:', miss, 'FÖRMÅNGA:', over);
