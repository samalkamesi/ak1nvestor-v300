  ['km-030-margin-of-safety', 'det intrinsika värdet', 'det intrinsiska värdet', 1],
  ['km-031-var', 'portföljförlustarna', 'portföljförlusterna', 1],
  ['km-031-var', 'underestimerar riskerna', 'underskattar riskerna', 1],
  // Sann/Sanna mästerskap -> Sant (mall, alla km i batch A)
  ['km-003-kassaflodesanalysen', /\bSann(a)? mästerskap\b/g, 'Sant mästerskap', 1],
  ['km-006-kvartalsrapporten', /\bSann(a)? mästerskap\b/g, 'Sant mästerskap', 1],
