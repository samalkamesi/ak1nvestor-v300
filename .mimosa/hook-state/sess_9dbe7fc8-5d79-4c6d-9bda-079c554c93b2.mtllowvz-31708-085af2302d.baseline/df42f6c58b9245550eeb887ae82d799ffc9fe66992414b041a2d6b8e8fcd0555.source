#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
AK1A Research Lab — portföljforskning, dubbelkontroll av bolagsuniversumet.

Läser data/portfolj-system/bolagsunivers.json (samt cache-filerna den bygger på)
och kontrollerar mot kontraktet i src/lib/portfolj-forskning/typer.ts:

  1. SCHEMA    — alla obligatoriska fält/namn exakt enligt BolagsNyckeltal-typen
                 (JSON-nycklar utan åäö), korrekta värdeformer.
  2. NULL-ANDEL — andel null per fält (ärlighet — null är tillåtet, gissade
                 värden är det inte).
  3. KÄLLOR     — minst 1 källa per post (varning om inte 2 — dubbelkoll-kravet).
  4. DATUM      — `hamtat` närvarande och ISO-formaterat hos post och källor.

Skriver data/rapporter/validera-univers-{datum}.md med tabeller.

Detta är en forskningsplattform. ALDRIG investeringsråd — endast data.
"""

from __future__ import annotations

import datetime as dt
import glob
import json
import os
import re
import sys

SKRIPT_ROT = os.path.dirname(os.path.abspath(__file__))
REPO_ROT = os.path.dirname(os.path.dirname(SKRIPT_ROT))
UNIVERS_FIL = os.path.join(REPO_ROT, "data", "portfolj-system", "bolagsunivers.json")
CACHE_KAT = os.path.join(REPO_ROT, "data", "cache")
RAPPORT_KAT = os.path.join(REPO_ROT, "data", "rapporter")

BRANSCHER = [
    "teknik", "industri", "halso", "konsument", "fastighet",
    "finans", "material", "energi", "kommunikation", "tillvaxt",
]
GOLV_TYPER = {"ncav", "reim", "tillgangstung", "ingen", "osatt"}

# Obligatoriska fält exakt enligt typer.ts (BolagsNyckeltal).
OBLIGATORISKA_TOPP = ["ticker", "namn", "bransch", "land", "valuta", "kallor", "hamtat", "pris",
                      "marknadsKapitalMdr", "tillvaxt", "lonksamhet", "stabilitet", "aterkop",
                      "moat", "vardering", "golv"]
GRUPPER = {
    "tillvaxt": ["omsattningCAGR5ar", "resultatCAGR5ar", "omsattningTillvaxtTTM", "prognosTillvaxt"],
    "lonksamhet": ["roe", "roic", "bruttoMarginal", "ebitMarginal", "nettoMarginal", "fcfMarginal"],
    "stabilitet": ["skuldEgenkapital", "rantaTackning", "fcfPositivaSenaste5",
                   "kassaManaderBurnRate", "nyemissionerSenaste5ar"],
    "aterkop": ["senasteArMdr", "andelUtestande", "insiderkopSenaste6man"],
    "moat": ["bruttoMarginalMedel5ar", "bruttoMarginalSpread5ar", "roeMedel5ar"],
    "vardering": ["pe", "pb", "evEbit", "peg", "fcfYield", "egenKapitalMultipl"],
}
# Alla numeriska fält som ingår i null-andelsstatistiken (toppnivå + grupper).
ALLA_TALFALT = (
    [("pris", None), ("marknadsKapitalMdr", None)]
    + [(f, g) for g, fs in GRUPPER.items() for f in fs]
    + [("vardePerAktie", "golv"), ("marginal", "golv")]
)

ISO_DATUM = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def las_json_saker(sokvag: str):
    """Läs JSON endast om den verkliga sökvägen ligger under repo-roten
    (Mimosa-krav: path traversal / symlinks avvisas)."""
    rot_verklig = os.path.realpath(REPO_ROT)
    verklig = os.path.realpath(sokvag)
    if not verklig.startswith(rot_verklig + os.sep):
        raise ValueError(f"sökväg utanför repo-roten avvisad: {sokvag!r}")
    with open(verklig, encoding="utf-8") as f:
        return json.load(f)


def las_univers() -> list[dict]:
    if not os.path.isfile(UNIVERS_FIL):
        print(f"FEL: {UNIVERS_FIL} saknas — kör samla_nyckeltal.py --bygg-univers först.")
        sys.exit(1)
    return las_json_saker(UNIVERS_FIL)


def ar_tal(v) -> bool:
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def kontrollera_post(post: dict, fel: list[str], varningar: list[str]) -> None:
    """Schema + källor + datum för en enskild post — felet hamnar i rätt lista."""
    tk = post.get("ticker", "??")

    # 1. Obligatoriska toppfält
    for falt in OBLIGATORISKA_TOPP:
        if falt not in post:
            fel.append(f"{tk}: saknar toppfält '{falt}'")

    # 2. Gruppfält
    for grupp, falt in GRUPPER.items():
        g = post.get(grupp)
        if not isinstance(g, dict):
            fel.append(f"{tk}: gruppen '{grupp}' saknas eller är inte objekt")
            continue
        for f in falt:
            if f not in g:
                fel.append(f"{tk}: saknar '{grupp}.{f}'")
            elif g[f] is not None and not ar_tal(g[f]):
                fel.append(f"{tk}: '{grupp}.{f}' är inte tal/null ({type(g[f]).__name__})")

    # 3. Golv-struktur
    golv = post.get("golv")
    if not isinstance(golv, dict) or "typ" not in golv:
        fel.append(f"{tk}: 'golv' saknar struktur")
    elif golv.get("typ") not in GOLV_TYPER:
        fel.append(f"{tk}: golv.typ='{golv.get('typ')}' utanför tillåtna värden")

    # 4. Källor (minst 1 — varna om färre än 2 enligt dubbelkollskravet)
    kallor = post.get("kallor") or []
    if len(kallor) < 1:
        fel.append(f"{tk}: inga källor alls")
    elif len(kallor) < 2:
        varningar.append(f"{tk}: endast {len(kallor)} källa — dubbelkoll ej uppfyllt")
    for k in kallor:
        if not isinstance(k, dict) or not k.get("namn") or not k.get("hamtat"):
            fel.append(f"{tk}: källpost ofullständig (namn/hamtat)")

    # 5. Datum
    if not isinstance(post.get("hamtat"), str) or not ISO_DATUM.match(post.get("hamtat", "")):
        fel.append(f"{tk}: 'hamtat' saknas eller ej ISO-datum")

    # 6. Bransch
    if post.get("bransch") not in BRANSCHER:
        fel.append(f"{tk}: bransch='{post.get('bransch')}' utanför kontraktet")

    # 7. Serier (optionella — men om de finns ska längderna stämma överens)
    s = post.get("serier")
    if isinstance(s, dict):
        langder = {k: len(s.get(k) or []) for k in ("ar", "omsattning", "resultat", "egetKapital", "fcf")}
        if langder["ar"] and not (langder["ar"] == langder["omsattning"] == langder["resultat"]):
            fel.append(f"{tk}: serier har olika längder: {langder}")


def huvud() -> None:
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")

    poster = las_univers()
    fel: list[str] = []
    varningar: list[str] = []

    for post in poster:
        kontrollera_post(post, fel, varningar)

    # ── Null-andel per fält ──
    null_raknare = {f"{g + '.' if g else ''}{f}": 0 for f, g in ALLA_TALFALT}
    for post in poster:
        for f, g in ALLA_TALFALT:
            v = (post.get(g) or {}).get(f) if g else post.get(f)
            if v is None:
                null_raknare[f"{g + '.' if g else ''}{f}"] += 1

    # ── Statistik per bransch ──
    per_bransch: dict[str, dict] = {}
    for post in poster:
        b = per_bransch.setdefault(post["bransch"], {"antal": 0, "serier": 0, "tvakallor": 0, "avvikelser": 0})
        b["antal"] += 1
        if post.get("serier") and post["serier"].get("ar"):
            b["serier"] += 1
        if len(post.get("kallor") or []) >= 2:
            b["tvakallor"] += 1
        if "AVVIKELSE" in (post.get("notering") or ""):
            b["avvikelser"] += 1

    totalt_null = sum(null_raknare.values())
    totalt_falt = len(null_raknare) * len(poster)
    null_andel = totalt_null / totalt_falt if totalt_falt else 0.0

    # ── Rapport ──
    dag = dt.date.today().isoformat()
    rader: list[str] = []
    rader.append("# Validering — bolagsuniversum (fundamentaldata)")
    rader.append("")
    rader.append(f"- **Datum:** {dag}")
    rader.append(f"- **Källa:** `data/portfolj-system/bolagsunivers.json` + `data/cache/fundamental-*.json`")
    rader.append(f"- **Kontrakt:** `src/lib/portfolj-forskning/typer.ts` (BolagsNyckeltal)")
    rader.append(f"- **Resultat:** {len(poster)} poster — **{len(fel)} schemafel**, {len(varningar)} varningar")
    rader.append(f"- **Total null-andel (nyckeltalsfält):** {null_andel:.1%} — null är ärlig avsaknad, aldrig gissning")
    rader.append("")
    rader.append("## Översikt per bransch")
    rader.append("")
    rader.append("| Bransch | Bolag | Med serier | ≥2 källor | Avvikelsemarkeringar |")
    rader.append("|---|---:|---:|---:|---:|")
    for b in BRANSCHER:
        s = per_bransch.get(b, {"antal": 0, "serier": 0, "tvakallor": 0, "avvikelser": 0})
        rader.append(f"| {b} | {s['antal']} | {s['serier']} | {s['tvakallor']} | {s['avvikelser']} |")
    rader.append("")

    rader.append("## Null-andel per fält")
    rader.append("")
    rader.append("| Fält | Null | Andel |")
    rader.append("|---|---:|---:|")
    for namn, n in sorted(null_raknare.items(), key=lambda x: -x[1]):
        rader.append(f"| `{namn}` | {n}/{len(poster)} | {n / len(poster):.0%} |")
    rader.append("")

    if fel:
        rader.append("## Schemafel (MÅSTE ÅTGÄRDAS)")
        rader.append("")
        for f in fel:
            rader.append(f"- {f}")
        rader.append("")
    else:
        rader.append("## Schemafel")
        rader.append("")
        rader.append("Inga — alla poster följer kontraktet.")
        rader.append("")

    if varningar:
        rader.append("## Varningar")
        rader.append("")
        for v in varningar:
            rader.append(f"- {v}")
        rader.append("")

    avvikelser = [(p["ticker"], [d for d in (p.get("notering") or "").split("; ") if "AVVIKELSE" in d]) for p in poster if "AVVIKELSE" in (p.get("notering") or "")]
    if avvikelser:
        rader.append("## Avvikelser mellan källor (>15 %)")
        rader.append("")
        for tk, ds in avvikelser:
            for d in ds:
                rader.append(f"- **{tk}**: {d}")
        rader.append("")

    rader.append("## Kända begränsningar (sammanfattning)")
    rader.append("")
    rader.append("- Yahoo ger 4 räkenskapsårs resultaträkningshistorik (ej 5) — CAGR noteras per post.")
    rader.append("- Balansräknings-/kassaflödeshistorik är tömd hos Yahoo — NCAV, FCF-serier, ROE-medel och räntetäckning blir null.")
    rader.append("- MarketStack fundamentals-endpoint ej tillgänglig på aktuell plan (HTTP 404) — källa B validerar endast pris/PE/PB/marknadsvärde.")
    rader.append("- MarketStack saknar färska kurser för de flesta icke-USA-börser — dubbelkoll främst för USA-bolag.")
    rader.append("- Återköpsbelopp och aktieantalshistorik saknas hos båda källorna — aterkop.senasteArMdr/andelUtestande null.")
    rader.append("")
    rader.append("---")
    rader.append("*AK1A Research Lab — pedagogisk forskning. ALDRIG investeringsråd.*")

    os.makedirs(RAPPORT_KAT, exist_ok=True)
    sokvag = os.path.join(RAPPORT_KAT, f"validera-univers-{dag}.md")
    with open(sokvag, "w", encoding="utf-8", newline="\n") as f:
        f.write("\n".join(rader) + "\n")

    # Konsolsammanfattning
    print(f"Validerad: {len(poster)} poster | {len(fel)} schemafel | {len(varningar)} varningar")
    print(f"Total null-andel nyckeltalsfält: {null_andel:.1%}")
    if fel:
        print("FEL (första 10):")
        for f in fel[:10]:
            print("  -", f)
    print(f"Rapport skriven: {sokvag}")
    sys.exit(1 if fel else 0)


if __name__ == "__main__":
    huvud()
