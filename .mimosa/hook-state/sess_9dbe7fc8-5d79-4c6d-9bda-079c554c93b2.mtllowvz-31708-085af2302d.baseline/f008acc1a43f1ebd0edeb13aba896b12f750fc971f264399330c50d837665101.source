#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
AK1A Research Lab — portföljforskning, steg 1: fundamental insamling.

Samla grundlagda nyckeltal för bolagsuniversumet (10 branscher × 10 bolag)
med DUBBELA OBEROENDE KÄLLOR och full spårbarhet:

  KÄLLA A — Yahoo Finance (quoteSummary med crumb-autentisering, samma mönster
            som src/lib/analys-motor.ts): pris, värdering, lönsamhet, skuldsättning,
            resultaträkningshistorik (4 räkenskapsår), konsenstillväxt, insiderköp.
  KÄLLA B — MarketStack (eod/latest, batchat): oberoende slutkurs som dubbelkollar
            prisberoende nyckeltal (pris, P/E, P/B, marknadsvärde).
            OBS: fundamentals-endpointen är INTE tillgänglig på aktuell plan
            (HTTP 404) — dokumenterad fallback, se manifest.json.

ÄRLIGHET: varje fält som inte kan beräknas ur källorna blir null — aldrig gissat.
Avvikelser > 15 % mellan källorna loggas i fältet `notering`.

UTDATA (exakt enligt src/lib/portfolj-forskning/typer.ts, JSON-nycklar utan åäö):
  data/cache/fundamental-{TICKER}.json   — ett BolagsNyckeltal per fil
  data/portfolj-system/bolagsunivers.json — hela universumet (via --bygg-univers)

ANVÄNDNING:
  python verktyg/python/samla_nyckeltal.py --bransch teknik     # en bransch (10 bolag)
  python verktyg/python/samla_nyckeltal.py --tickers MSFT,ABB.ST
  python verktyg/python/samla_nyckeltal.py --alla               # allt (ca 5-6 min)
  python verktyg/python/samla_nyckeltal.py --bygg-univers       # slå ihop cache → univers

Detta är en forskningsplattform. ALDRIG investeringsråd — endast data.
"""

from __future__ import annotations

import argparse
import datetime as dt
import ipaddress
import json
import math
import os
import re
import socket
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# ── Sökvägar ─────────────────────────────────────────────────────────────────
SKRIPT_ROT = os.path.dirname(os.path.abspath(__file__))
REPO_ROT = os.path.dirname(os.path.dirname(SKRIPT_ROT))          # verktyg/python → repo
CACHE_KAT = os.path.join(REPO_ROT, "data", "cache")
SYSTEM_KAT = os.path.join(REPO_ROT, "data", "portfolj-system")
ENV_FIL = os.path.join(REPO_ROT, ".env")

