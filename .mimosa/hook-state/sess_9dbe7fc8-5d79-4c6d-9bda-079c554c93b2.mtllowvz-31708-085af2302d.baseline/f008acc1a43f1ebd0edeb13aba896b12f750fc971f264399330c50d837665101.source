BRANSCH_ORDNING = [
    "teknik", "industri", "halso", "konsument", "fastighet",
    "finans", "material", "energi", "kommunikation", "tillvaxt",
]

UNIVERSUM: dict[str, list[str]] = {
    "teknik": ["MSFT", "GOOGL", "AAPL", "ERIC-B.ST", "NOKIA.HE", "SAP.DE", "SINCH.ST", "ASM.AS", "LOGN.SW", "KAMBI.ST"],
    "industri": ["ABB.ST", "ATCO-A.ST", "INDU-C.ST", "ALFA.ST", "SAND.ST", "SKF-B.ST", "ASSA-B.ST", "HEXA-B.ST", "ETN", "GE"],
    "halso": ["AZN.ST", "NOVO-B.CO", "COLO-B.CO", "EKTA-B.ST", "GETI-B.ST", "JNJ", "LLY", "BSX", "FRE.DE", "CEVI.ST"],
    "konsument": ["HM-B.ST", "ESSITY-B.ST", "ELUX-B.ST", "VOLCAR-B.ST", "PG", "NKE", "MCD", "MC.PA", "CARL-B.CO", "ITX.MC"],
