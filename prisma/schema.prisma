// AK1A Research Lab — Mega-projekt databas-schema
// Sparar: indikatorer (V01-V20), djupa kurser, fallstudier (200+ success/failure),
// indikator-kombinationer (200+), styrelseprotokoll, mega-uppgifter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// AK1A:s indikatorer — V01..V20 (V20 = återköp av egna aktier, tillagd i mega-projektet)
model Ak1Indicator {
  id          String   @id // "V01".."V20"
  num         Int      @unique
  name        String
  category    String   // Tillväxt, Värdering, Lönsamhet, Stabilitet, Moat, Katalysator, Risk, Kapitalstruktur
  weight      String   // "8%" eller "KRITISK"
  level       String   // nyborjare | intermediar | avancerad
  summary     String
  formula     String?
  scale       String?
  lynchView   String?  // Peter Lynchs perspektiv
  grahamView  String?  // Benjamin Grahams perspektiv
  ak1View     String?  // AKM1:s perspektiv
  slug        String?  // deep course slug
  createdAt   DateTime @default(now())

  combinationsA IndicatorCombination[] @relation("IndicatorA")
  combinationsB IndicatorCombination[] @relation("IndicatorB")
}

/// Fallstudier — 200+ lyckade, 200+ misslyckade
model CaseStudy {
  id           String   @id @default(cuid())
  type         String   // "success" | "failure"
  company      String
  ticker       String
  title        String   // one-line lesson
  description  String   // full description
  akm1Score    Int?     // /95 (or /100 with V20)
  decisiveVars String   // comma-separated V01,V10 etc
  sector       String?
  year         Int?
  outcome      String?  // "150% gain", "-90% loss", etc
  lesson       String?  // pedagogical takeaway
  isIllustrative Boolean @default(false)
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([sector])
}

/// Indikator-kombinationer — 200+ kurser om vad händer när två indikatorer samverkar
model IndicatorCombination {
  id           String   @id @default(cuid())
  indicatorAId String
  indicatorBId String
  pattern      String   // t.ex. "hög tillväxt + hög kapitalförbränning"
  outcome      String   // "emission-fälla" | "compounder" | "value trap" etc
  verdict      String   // "bull" | "bear" | "neutral" | "warning"
  title        String
  description  String
  example      String?  // bolagsexempel
  courseBody   String?  // full kurs-text
  createdAt    DateTime @default(now())

  indicatorA   Ak1Indicator @relation("IndicatorA", fields: [indicatorAId], references: [id])
  indicatorB   Ak1Indicator @relation("IndicatorB", fields: [indicatorBId], references: [id])

  @@index([indicatorAId, indicatorBId])
  @@index([verdict])
}

/// Styrelseprotokoll — sparar alla AI-organ möten
model MeetingProtocol {
  id           String   @id @default(cuid())
  meetingId    String   @unique // "M-XXXXX"
  agenda       String
  timestamp    DateTime @default(now())
  viewpoints   String   // JSON array of viewpoints
  decision     String   // JSON decision object
  decisionTitle String?
  confidence   String?  // LÅG | MEDEL | HÖG
  passed       Boolean?
  signatures   String?  // JSON array
}

/// Mega-uppgifter — 42+ tasks för projektet
model MegaTask {
  id           String   @id @default(cuid())
  num          Int      @unique
  title        String
  description  String
  category     String   // indikator | kurs | fallstudie | kombination | integration | databas
  priority     String   // HÖG | MEDEL | LÅG
  status       String   @default("pending") // pending | in_progress | completed | metodmal
  organOwner   String?  // vilket organ äger uppgiften (Σ α Δ Ω Φ Θ Μ Ψ)
  estimatedXp  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([priority])
  @@index([status])
}

/// Djupa kurser — sparar kursdata i databasen (från JSON till DB)
model DeepCourse {
  id           String   @id @default(cuid())
  slug         String   @unique
  variableId   String   // "V01".."V20"
  title        String
  category     String
  weight       String
  chapterCount Int
  totalMinutes Int
  summary      String
  minutes      Int
  xp           Int
  level        String
  learn        String
  why          String
  history      String?  // JSON
  chapters     String   // JSON array of chapters
  lynchSection String?  // Lynch-perspektiv sektion
  grahamSection String? // Graham-perspektiv sektion
  ak1Section   String?  // AKM1-perspektiv sektion
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// ADMIN & LOGGING — klientaktivitet, portföljer, analyssessioner
// ============================================================

/// Användaraktivitet — loggar alla klientinteraktioner för admin-insyn
model UserActivity {
  id           String   @id @default(cuid())
  sessionId    String   // anonym session-id (localStorage)
  action       String   // section_visit | course_open | course_complete | portfolio_create | portfolio_update | analysis_run | search | meeting_convened | organ_consulted
  section      String?  // hem | kurser | labb | styrelse | analyser | etc
  targetType   String?  // course | portfolio | analysis | case | combination | meeting
  targetId     String?  // slug/id för objektet
  metadata     String?  // JSON med extra data (XP, score, etc)
  userAgent    String?
  ipHash       String?  // hashat IP för anonym statistik
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([action])
  @@index([createdAt])
  @@index([section])
}

/// Klientportföljer — fiktiva portföljer byggda av användare i Labbet
model Portfolio {
  id           String   @id @default(cuid())
  sessionId    String   // ägare (anonym session-id)
  name         String
  description  String?
  totalValue   Float    @default(0)
  cashPosition Float    @default(0)
  riskScore    Float?   // genomsnittlig AKM1-riskpoäng 0-100
  moatScore    Float?   // genomsnittlig moat-poäng
  growthScore  Float?   // genomsnittlig tillväxtpoäng
  valueScore   Float?   // genomsnittlig värderingspoäng
  waveAnalysis String?  // JSON: Elliott Wave position per innehav
  technicalScore Float? // genomsnittlig teknisk poäng
  fundamentalScore Float? // genomsnittlig fundamental poäng
  scenarioBull Float?   // scenario-analys
  scenarioBase Float?
  scenarioBear Float?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  holdings     PortfolioHolding[]

  @@index([sessionId])
  @@index([createdAt])
}

/// Innehav i portfölj — enskilda aktiepositioner med djup analys
model PortfolioHolding {
  id           String   @id @default(cuid())
  portfolioId  String
  ticker       String   // t.ex. "ATCO-A.ST"
  company      String
  sector       String?
  weight       Float    // procent av portfölj
  shares       Float?
  entryPrice   Float?
  currentPrice Float?
  costBasis   Float?
  // AKM1-poäng per variabel (V01-V20) som JSON
  akm1Scores   String?  // {"V01": 4, "V02": 3, ...}
  akm1Total    Int?     // total poäng /95 eller /100
  // Teknisk analys
  technicalAnalysis String? // JSON: trend, RSI, MACD, MA50, MA200, volume, support, resistance
  technicalScore Float?
  // Fundamental analys
  fundamentalAnalysis String? // JSON: PE, PB, PS, EV/EBITDA, ROE, marginaler, skuldsättning
  fundamentalScore Float?
  // Elliott Wave analys
  wavePosition String?  // "impulse 3 of 5" | "corrective A-B-C" | etc
  waveTimeframe String? // "vecka" | "månad" | "kvartal"
  waveConfidence Float?
  // Insikter och anteckningar
  thesis       String?  // investeringsberättelse
  risks        String?  // nyckelrisker
  catalysts    String?  // kommande katalysatorer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([ticker])
}

/// Analyssessioner — djupa analys-sessioner som klienter kör
model AnalysisSession {
  id           String   @id @default(cuid())
  sessionId    String   // ägare
  portfolioId  String?
  type         String   // full_diagnostic | technical_deep | fundamental_deep | wave_analysis | scenario | stress_test
  ticker       String?
  status       String   @default("running") // running | completed | failed
  input        String?  // JSON: inmatade parametrar
  output       String?  // JSON: resultat
  score        Float?   // total poäng om applicable
  duration     Int?     // millisekunder
  error        String?
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
}

/// AI-organ konsultationer — loggar djupare frågor till AI-organen
model OrganConsultation {
  id           String   @id @default(cuid())
  sessionId    String
  organ        String   // Σ | α | Δ | Ω | Φ | Θ | Μ | Ψ
  question     String
  context      String?  // JSON: bakgrundsinformation
  response     String?  // JSON: organets svar
  meetingId    String?  // koppling till MeetingProtocol
  depth        String   @default("standard") // standard | deep | mega
  confidence   String?  // LÅG | MEDEL | HÖG
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([organ])
  @@index([createdAt])
}

/// System events — admin-relevanta händelser
model SystemEvent {
  id           String   @id @default(cuid())
  type         String   // api_error | rate_limit | generation_complete | db_migration | server_restart | watchdog
  severity     String   @default("info") // info | warning | error | critical
  message      String
  details      String?  // JSON
  source       String?  // watchdog | generator | api | admin
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([severity])
  @@index([createdAt])
}
