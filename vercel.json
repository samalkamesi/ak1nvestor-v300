{
  "framework": "nextjs",
  "buildCommand": "rm -rf .next node_modules/@prisma node_modules/.prisma && next build",
  "installCommand": "npm install --legacy-peer-deps --no-optional",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/autonom",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/expand-courses",
      "schedule": "0 12 * * *"
    }
  ]
}
