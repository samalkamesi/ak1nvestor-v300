#!/usr/bin/env bash
# KVALITETSGRINDEN (våg 138) — mekanisk pre-commit, aktiveras på SERVERN via:
#   git config core.hooksPath verktyg/hooks
# (hook-filerna är versionshanterade i repot; arbetsstationen håller sin egen
# Mimosa-hook och sätter INTE hooksPath.)
#
# Två hårda regler, båda mekaniska (ingen disciplin behövs):
#   1) TYPNOLLEN (våg 133): tsc får ha 0 fel — feltypad kod kan inte committas.
#      Merge-committar hoppas över (ändringarna typgranskades i grenarna;
#      arbetsstationen kör tsc efter varje merge mot samma baslinje).
#      tsc körs inkrementellt (tsconfig incremental: true) — någon sekund
#      efter första körningen, inte minuter.
#   2) R2-HEMLIGHETSSKYDDET: .env*/pem/key/rsa-liknande filer kan ALDRIG
#      committas — kunden äger nycklarna (styrelseregel R2).
#      s8-u1-härdning (2026-09-15): bevistest D visade att .p12/.pfx/.jks/
#      .kdbx/.htpasswd passera(de) okontrollerade — filformat där HELA
#      filen är nyckelmaterial/valv/autentiseringshash hör hemma i samma
#      hårda regel. (.gpg medvetet UTE: publika nycklar är legitimt innehåll.)
# ALDRIG `git commit --no-verify` (AGENTS.md § KVALITETSGRINDEN).
cd "$(git rev-parse --show-toplevel)" || exit 1

if git diff --cached --name-only | grep -qE '(^|/)\.env|\.pem$|\.key$|id_rsa|id_ed25519|\.p12$|\.pfx$|\.jks$|\.kdbx$|\.htpasswd$|(^|/)secrets?\.'; then
  echo "KVALITETSGRINDEN: hemlighet-liknande fil är stegad (.env*/pem/key/rsa/p12/pfx/jks/kdbx/htpasswd) — commit BLOCKERAD (R2: nycklar ägs av kunden)" >&2
  exit 1
fi

if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

# s8-u2 (2026-09-17, SYSTEMKARTAN gap 5 kö 1): signaturverifierad tmp-städning
# FÖRE typmätningen. Femton körskript genererar tmp_*.ts i repo-roten och
# städar dem i finally — finally överlever INTE SIGKILL (fabrikstak/OOM/kill),
# och tsconfig inkluderar "**/*.ts" ⇒ läckan typas av tsc och låste ALLA
# commits (bevisat 2026-09-17 01:19: tmp_demoklient_koll.ts, vakt GUL + svit
# 9/2). Grinden självläker KÄNT engångsskräp (verktyg/tmp-stad.mjs: rot-nivå +
# namnmönster + INTE git-trackad + GENERERAD-signatur); okända filer lämnas
# åt tsc som blockerar TYDLIGT. Städarens eget fel låser ALDRIG commit-taket
# (|| echo) — tsc förblir den hårda grinden.
node verktyg/tmp-stad.mjs || echo "KVALITETSGRINDEN: tmp-städningen kunde inte köras — fortsätter (tsc avgör)" >&2

# v186 (2026-09-27, r275): SPEGLAR-DRIFT-VAKTEN — en commit som röra data/blogg
# eller sok-index MÅSTE bära en aktuell public/speglar-slugar.json. Bevisat
# behov: 39 bloggslugar glappade (listan frusen 2026-09-21; pipelinen som
# skriver data/blogg uppdaterar den aldrig) = 78 spegelsidor /en|/ar svarade
# äkta 404 på sidor som fanns OCH lovades i sitemapen. Kontroll-läget skriver
# ALDRIG — drift blockerar med kur-text.
if git diff --cached --name-only | grep -qE '^data/blogg/|^public/sok-index\.json$'; then
  if ! node verktyg/kor-speglar-slugar.mjs --kontroll; then
    echo "" >&2
    echo "KVALITETSGRINDEN: speglar-drift ovan — kör node verktyg/kor-speglar-slugar.mjs och committa public/speglar-slugar.json i SAMMA commit." >&2
    exit 1
  fi
fi

# s8-determinism (2026-09-15): projektets EGEN tsc-binär, ALDRIG npx — mitt i
# en deploy (npm ci river node_modules) kan npx lösa "tsc" till cachens
# dummy-paket tsc@2.0.4 (bevisat 2026-09-15 04:57, deployfönster). Saknad
# binär ⇒ node skriver "Cannot find module" och hoken blockerar TYDLIGT —
# committa efter deployfönstret istället (AGENTS.md: aldrig bygga olåst).
if ! node node_modules/typescript/bin/tsc --noEmit; then
  echo "" >&2
  echo "KVALITETSGRINDEN: tsc-fel ovan — typnollen (0 fel, våg 133) gäller mekaniskt. Fixa och committa igen." >&2
  exit 1
fi
exit 0
